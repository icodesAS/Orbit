rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidOpportunity(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.status in ['active', 'waitlist', 'submitted', 'archived'];
    }

    function isValidProject(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200;
    }

    match /users/{userId} {
      match /opportunities/{oppId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidOpportunity(request.resource.data);

        match /tasks/{taskId} {
          allow read, write: if isOwner(userId);
        }
        match /aiChat/{chatId} {
          allow read, write: if isOwner(userId);
        }
      }
      match /projects/{projectId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidProject(request.resource.data);
      }
      match /radarDays/{day} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /radarDays/{day}/items/{itemId} {
        allow read: if isOwner(userId);
        allow create, delete: if false;
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['promoted', 'verified'])
          && request.resource.data.promoted is bool
          && request.resource.data.verified is bool;
      }
    }
  }
}
